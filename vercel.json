{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/pages/taxe-fonciere",
      "destination": "/pages/taxe",
      "permanent": true
    },
    {
      "source": "/pages/top-25-revenu-median-france-2026",
      "destination": "/pages/revenu-median-commune",
      "permanent": true
    },
    {
      "source": "/pages/frais-notaire",
      "destination": "/pages/notaire",
      "permanent": true
    },
    {
      "source": "/pages/blog/frais-notaire-((?:[0-9]{2,3}|2A|2B))",
      "destination": "/pages/blog/departements/frais-notaire-$1",
      "permanent": true
    },
    {
      "source": "/pages/blog/frais-notaire-ancien-neuf-2025",
      "destination": "/pages/blog/frais-notaire-ancien-neuf-2026",
      "permanent": true
    },
    {
      "source": "/blog/departements/(.*)",
      "destination": "/pages/blog/departements/$1",
      "permanent": true
    },
    {
      "source": "/blog/(.*)",
      "destination": "/pages/blog/$1",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://www.lescalculateurs.fr/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "^lescalculateurs\\.fr$"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "destination": "/$1",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
